{:biff.ring/base-url #or [#biff/env BASE_URL "http://localhost:8080"]
 :biff.auth/base-url #ref [:biff.ring/base-url]
 :biff.ring/host #or [#biff/env HOST "localhost"]
 :biff.ring/port #long #or [#biff/env PORT "8080"]
 :biff.sqlite/db-path #or [#biff/env SQLITE_DB_PATH "storage/sqlite/main.db"]
 :mtz/upload-dir #or [#biff/env UPLOAD_DIR "storage/uploads"]

 :cf/account-id    #biff/env CLOUDFLARE_ACCOUNT_ID
 :cf/api-token     #biff/secret CLOUDFLARE_IMAGES_TOKEN
 :cf/images-hash   #biff/env CLOUDFLARE_IMAGES_HASH

 :r2/bucket        #biff/env R2_BUCKET
 :r2/access-key-id #biff/secret R2_ACCESS_KEY_ID
 :r2/secret-key    #biff/secret R2_SECRET_KEY
 :r2/public-url    #biff/env R2_PUBLIC_URL
 :biff.nrepl/port #long #or [#biff/env NREPL_PORT "7888"]
 :biff.ring/cookie-secret #biff/secret COOKIE_SECRET
 :biff.ring/secure #boolean #or [#biff/env SECURE "true"]
 :biff.auth/app-name "Mount Zion UCC"

 :biff.tasks/main-ns com.mtzion
 :biff.tasks/css-output "target/resources/public/css/main.css"
 :biff.tasks/server #biff/env SERVER
 :biff.tasks/deployment-name #or [#biff/env DEPLOYMENT_NAME "app"]
 :biff.tasks/git-deploy-cmd
 ["git" "push"
  #join ["ssh://" #ref [:biff.tasks/deployment-name] "@"
         #ref [:biff.tasks/server]
         "/home/" #ref [:biff.tasks/deployment-name] "/repo.git"]
  "HEAD:master"]
 :biff.tasks/deploy-untracked-files
 [#ref [:biff.tasks/css-output]
  {:src "config.prod.env" :dest "config.env"}]

 :mailersend/api-key #biff/secret MAILERSEND_API_KEY
 :mailersend/from #biff/env MAILERSEND_FROM
 :mailersend/from-name "Mount Zion UCC"
 :mailersend/reply-to #biff/env MAILERSEND_REPLY_TO

 ;; Where contact-form submissions are delivered (the church office).
 ;; Falls back to :mailersend/reply-to when unset.
 :mtz/contact-to #biff/env CONTACT_TO

 ;; Cloudflare Web Analytics site token. NOT a secret — it is visible in the
 ;; page source by design. Unset means no beacon is emitted at all, so local
 ;; development and tests never report traffic.
 :mtz/analytics-token #biff/env CF_ANALYTICS_TOKEN

 :biff.auth/turnstile-site-key #biff/env TURNSTILE_SITE_KEY
 :biff.auth/turnstile-secret #biff/secret TURNSTILE_SECRET_KEY

 :biff.admin/user-id #biff/env BIFF_ADMIN_USER_ID
 :biff.admin/alert-email #biff/env BIFF_ADMIN_ALERT_EMAIL}
