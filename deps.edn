{:paths ["src" "resources" "target/resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ring/ring-core {:mvn/version "1.12.1"}
        ring/ring-jetty-adapter {:mvn/version "1.12.1"}
        ring/ring-defaults {:mvn/version "0.5.0"}
        metosin/muuntaja {:mvn/version "0.6.11"}
        metosin/reitit-ring {:mvn/version "0.7.2"}
        com.lambdaisland/hiccup {:mvn/version "0.14.67"}
        metosin/malli {:mvn/version "0.16.3"}
        hato/hato {:mvn/version "1.0.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        io.github.biffweb/config {:git/tag "v1.0" :git/sha "cc7ba13"}
        nrepl/nrepl {:mvn/version "1.1.1"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.13"}
        tick/tick {:mvn/version "1.0"}
        io.github.jacobobryant/biff.authenticate {:git/sha "39ed378d90006dcd7de32cb34aabf4b1852d9b88"}
        io.github.jacobobryant/biff.sqlite {:git/sha "e82c43d41fc2fdc3f0fb06fc9580c51105117ab2"}
