        io.github.jacobobryant/biff.graph {:git/sha "bf162fbecf860dc27735937de0cd9a2271a92c15"}
        io.github.jacobobryant/biff.admin {:git/sha "a5ee135ed339c7b7f7fb0258d1e1d2bf4825294b"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :prod {:jvm-opts ["-Djdk.attach.allowAttachSelf"
                    "--add-exports=java.base/sun.nio.ch=ALL-UNNAMED"
                    "--add-exports=java.base/sun.security.action=ALL-UNNAMED"
                    "-XX:-OmitStackTraceInFastThrow"
                    "-XX:+CrashOnOutOfMemoryError"]
         :main-opts ["-m" "com.example"]}
  :run {:extra-deps {io.github.biffweb/tasks {:git/sha "1125e409f10c475a41a9bc00a63e248ced001f36"}}
        :main-opts ["-m" "com.biffweb.cljrun" "com.biffweb.tasks/tasks" "--"]}}}
